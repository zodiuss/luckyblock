{
    "schemaVersion": 1,
    "id": "lucky",
    "version": "${version}",
    "name": "Lucky Block",
    "description": "Modern implementation of the classic lucky block mod: break the lucky block, get something random. Easily create your own lucky blocks",
    "authors": [
        "zodiuss"
    ],
    "icon": "assets/lucky/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.zodiuss.luckyblock.fabric.LuckyBlockFabric"
        ],
        "fabric-datagen": [
            "net.zodiuss.luckyblock.fabric.LuckyBlockDataGenerator"
        ]
    },
    "mixins": [
        "luckyblock.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.14",
        "minecraft": "1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    }
}
